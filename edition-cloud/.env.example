# =====================================================================
# UPCI ALERT — édition portable, domicile NODE (serveur d'établissement)
# Copiez ce fichier en « .env » à la racine du projet et adaptez.
# TOUTES ces valeurs sont des PLACEHOLDERS — aucun secret réel ne doit
# être partagé ni commité. La plupart des réglages métier peuvent
# aussi (et plus simplement) être saisis dans la page /installation :
# ils vivent alors dans la base et priment sur ce fichier.
# =====================================================================

# --- Serveur HTTP -----------------------------------------------------
PORT=8080
HOST=0.0.0.0

# --- Base SQLite (un seul fichier ; la sauvegarde = sa copie) ---------
# UPCI_DB_PATH=data/upci.sqlite

# --- Amorçage plateforme ----------------------------------------------
# Secret de signature des cookies de session (chaîne aléatoire longue).
UPCI_SESSION_SECRET=
# Clé de l'endpoint /cron si un planificateur externe l'appelle
# (la minuterie interne de server.mjs suffit sinon).
UPCI_CRON_KEY=
# URL publique de l'application (liens des courriels et affiches ;
# requise pour enregistrer le webhook Telegram).
UPCI_BASE_URL=

# --- Secours / pré-configuration (facultatif : /installation suffit) --
UPCI_ETABLISSEMENT=
UPCI_WILAYA=
UPCI_TELEGRAM_TOKEN=
UPCI_TELEGRAM_CHATS=
UPCI_TELEGRAM_SECRET=
UPCI_CLOSURE_KEY=
# Empreinte PBKDF2 du mot de passe admin — générez-la avec :
#   node cli/hash.mjs 'VotreMotDePasse'
UPCI_ADMIN_HASH=

# --- Courriel via API HTTPS (optionnel — voir INSTALL.md) -------------
UPCI_MAIL_API_URL=
UPCI_MAIL_API_KEY=
UPCI_MAIL_FROM=upci@exemple.dz
UPCI_EMAILS_ALERTES=chef-upci@exemple.dz, admin@exemple.dz
